# ---------- AI (server only — never exposed to the browser) ----------
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# Optional: Gemini model for crunch, coach, task guide and timetable OCR
GEMINI_MODEL=gemini-3.8-flash
# Optional: max AI requests per user per 10 minutes
AI_RATE_LIMIT=30

# ---------- Supabase (accounts + cloud database) ----------
# Leave these empty to run locally with the single-user SQLite database.
# Supabase → Project Settings → API. The anon key is safe to expose in the browser;
# row-level security in supabase/schema.sql protects each student's data.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# The server reads these (it also falls back to the VITE_ versions above).
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ---------- Local server ----------
PORT=3001
